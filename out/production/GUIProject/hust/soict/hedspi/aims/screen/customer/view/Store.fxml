<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" prefWidth="1024" prefHeight="768"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml">

    <padding>
        <Insets left="20"/>
    </padding>

    <HBox alignment="CENTER" prefHeight="100">
        <Label text="AIMS" style="-fx-font-size: 50px; -fx-text-fill: #004cff;">
            <HBox.margin>
                <Insets left="10"/>
            </HBox.margin>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="View Cart" prefWidth="100" prefHeight="50"
                onAction="#btnViewCartPressed">
            <HBox.margin>
                <Insets right="20"/>
            </HBox.margin>
        </Button>
    </HBox>

    <ScrollPane prefWidth="1024" prefHeight="760" fitToWidth="true">
        <GridPane fx:id="gridPane" prefWidth="0" prefHeight="0"/>
    </ScrollPane>

</VBox>